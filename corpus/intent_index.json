  {
    "category": "errors",
    "intent": "Confidence interval for a parameter",
    "pyxspec": "Fit.error(\"2.706 1-3\"); AllModels(1)(1).error",
    "tcl": "error 1-3",
    "refs": [
      [
        "FitManager",
        "error"
      ],
      [
        "Parameter",
        "error"
      ]
    ],
    "note": "error is (lo, hi, code); code 'FFFFFFFFF' = clean"
  },
  {
    "category": "errors",
    "intent": "Steppar (1-D/2-D confidence scan)",
    "pyxspec": "Fit.steppar(\"2 1.5 2.5 20\")",
    "tcl": "steppar 2 1.5 2.5 20",
    "refs": [
      [
        "FitManager",
        "steppar"
      ]
    ],
    "note": ""
  },
  {
    "category": "errors",
    "intent": "Get steppar results",
    "pyxspec": "Fit.stepparResults(\"delstat\")",
    "tcl": "-",
    "refs": [
      [
        "FitManager",
        "stepparResults"
      ]
    ],
    "note": ""
  },
  {
    "category": "errors",
    "intent": "Goodness of fit (Monte Carlo)",
