      [
        "FitManager",
        "renorm"
      ]
    ],
    "note": ""
  },
  {
    "category": "fit",
    "intent": "Get statistic and dof",
    "pyxspec": "Fit.statistic; Fit.dof",
    "tcl": "tclout stat; tclout dof",
