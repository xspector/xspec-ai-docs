{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xspec-ai-docs/casebook/case.schema.json",
  "title": "Casebook case (frontmatter)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "context", "decisions", "outcome", "lessons", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["contrib", "reviewed", "core"]},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission", "counts_regime", "grouped", "background", "source_type", "model_family", "statistic"],
      "properties": {
        "mission": {"type": "string", "minLength": 1},
        "instrument": {"type": "string"},
        "counts_regime": {"enum": ["vlow", "low", "mid", "high", "vhigh"]},
        "grouped": {"type": "boolean"},
        "background": {"enum": ["none", "subtracted", "modeled", "dominated"]},
        "source_type": {"enum": ["agn", "xrb", "cv", "star", "snr", "pwn_pulsar", "isolated_ns", "cluster", "galaxy", "grb", "tde", "solar_system", "diffuse", "other"]},
        "source_class": {"type": "string"},
        "model_family": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "statistic": {"enum": ["cstat", "chi", "lstat", "pgstat", "pstat", "whittle", "chicov", "chistokes"]},
        "abund": {"type": "string"},
        "xsect": {"type": "string"}
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "choice"],
        "properties": {
          "point": {"enum": ["statistic", "band", "grouping", "model", "add_component", "errors", "stop"]},
          "choice": {"type": "string", "minLength": 1},
          "rejected": {"type": "string"},
          "rationale": {"type": "string"},
          "trigger": {"type": "string"}
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict"],
      "properties": {
        "verdict": {"enum": ["recorded", "human-reviewed", "bench-validated"]},
        "fit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statistic", "dof", "method"],
          "properties": {
            "statistic": {"type": "number"},
            "dof": {"type": "integer"},
            "method": {"type": "string"}
          }
        },
        "result": {"type": "object"}
      }
    },
    "lessons": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "date"],
      "properties": {
        "source": {"type": "string"},
        "contributor": {"type": "string"},
        "date": {"type": "string", "format": "date"},
        "reviewed_by": {"type": "array", "items": {"type": "string"}},
        "synthetic_twin": {"type": ["string", "null"]}
      }
    }
  }
}
